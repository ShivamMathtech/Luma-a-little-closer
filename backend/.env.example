ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://luma:luma_local_only@localhost:5432/luma
SECRET_KEY=development-only-replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_MINUTES=15
REFRESH_DAYS=30
STORAGE_BACKEND=local
MEDIA_ROOT=var/media
UPLOAD_MAX_MB=30
MAIL_BACKEND=file
MAIL_ROOT=var/mail
# Run python -m app.workers.run to write local verification/reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Luma <noreply@example.com>
SMTP_TLS=true
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOG_LEVEL=INFO
